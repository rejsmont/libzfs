# OPTIONAL. Writes the health report in Prometheus text format for node_exporter's
# textfile collector. Not enabled by anything: see zfsbackup-check.timer.
#
# Change the output path for your node_exporter, either by editing the line
# below or with `systemctl edit zfsbackup-check.service`. The directory must
# exist and be the one node_exporter reads (--collector.textfile.directory).
[Unit]
Description=ZFS Backup health check (Prometheus textfile)

[Service]
Type=oneshot
# A hung pool must not hang this unit for ever (Type=oneshot has no start
# timeout by default). `check` bounds its own zfs reads (a time limit for the
# whole run, 60 s by default, and 10 s per zfs command; what it did not get to
# is reported as one WARN entry, never as silence), so the unit gets twice the
# limit plus a margin before systemd kills it: 2 x 60 s + 30 s. If you raise
# the check's time limit in ExecStart, raise this to at least twice that plus 30.
# A unit killed by this timeout fails and leaves the previous file in place.
TimeoutStartSec=150
Environment=ZFSBACKUP_CHECK_OUTPUT=/var/lib/node_exporter/textfile_collector/zfsbackup.prom
ExecStart=/opt/zfsbackup/venv/bin/zfsbackup-config -c /var/lib/zfsbackup/config.db check --prometheus --output ${ZFSBACKUP_CHECK_OUTPUT}
# With --output, `check` exits 0 once the file is written, whatever the verdict:
# health is in the metrics (zfsbackup_*_check_state, zfsbackup_check_success), not
# in this unit's state. A failed unit therefore means the check could not run or
# could not write the file (database unusable, unwritable path, a crash); the
# previous file stays, and zfsbackup_check_timestamp_seconds shows how old it is.
